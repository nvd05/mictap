<Window x:Class="MicTap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:local="clr-namespace:MicTap.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Style="{StaticResource MaterialDesignWindow}"
        Title="mictap" Icon="Assets/mictap.ico" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceBrush}"
        Closing="OnWindowClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <sys:Boolean x:Key="Confirm">True</sys:Boolean>

        <StackPanel x:Key="CloseDialog" x:Shared="False" Margin="24" MaxWidth="360">
            <materialDesign:PackIcon Kind="MicrophoneOff" Width="28" Height="28" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Text="Остановить запись?"
                       Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" />
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.8"
                       Text="Идёт запись. Если закрыть mictap, она остановится, а записанное сохранится."
                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Button Content="Остановить и выйти" Margin="8,0,0,0" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{StaticResource Confirm}" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Key="ProjectDialog" x:Shared="False" Margin="24" Width="400" d:DataContext="{d:DesignInstance Type=local:ProjectEditor}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" />
            <TextBox Margin="0,20,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Название"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                     AutomationProperties.Name="Название проекта" IsEnabled="{Binding IsNew}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Margin="0,16,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                     materialDesign:HintAssist.Hint="Языки: ja, ru — первый по умолчанию" AutomationProperties.Name="Языки проекта"
                     Text="{Binding LanguagesText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Margin="0,16,0,0" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                      materialDesign:HintAssist.Hint="Звук после распознавания" AutomationProperties.Name="Звук после распознавания"
                      ItemsSource="{x:Static local:ProjectEditor.RetentionOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                      SelectedValue="{Binding Retention}" />
            <ComboBox Margin="0,16,0,0" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                      materialDesign:HintAssist.Hint="Кто распознаёт фразы" AutomationProperties.Name="Кто распознаёт фразы"
                      ItemsSource="{x:Static local:ProjectEditor.EngineOptions}" DisplayMemberPath="Name" SelectedValuePath="Value"
                      SelectedValue="{Binding Engine}" />
            <TextBox Margin="0,16,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                     materialDesign:HintAssist.Hint="Модель Router AI" AutomationProperties.Name="Модель Router AI"
                     materialDesign:HintAssist.HelperText="Например openai/gpt-4o-transcribe или elevenlabs/scribe-v2. Черновик всё равно на этом компьютере."
                     Visibility="{Binding IsCloud, Converter={StaticResource VisibleWhenTrue}}"
                     Text="{Binding CloudModel, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,26,0,0" Text="Фраза заканчивается после паузы" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
            <DockPanel Margin="0,4,0,0">
                <TextBlock DockPanel.Dock="Right" Width="52" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding PhrasePauseText}" Style="{StaticResource MaterialDesignBodyLargeTextBlock}" />
                <Slider Minimum="0.5" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                        AutomationProperties.Name="Пауза, после которой фраза закончена" Value="{Binding PhrasePauseSeconds}" />
            </DockPanel>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                       Text="Лекция — около 1 с: фразы короче, агент получает текст быстрее. Разговор, где думают перед ответом, — 2–3 с. Действует со следующей записи." />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Error}" Foreground="{StaticResource RecordBrush}"
                       Style="{StaticResource MaterialDesignBodySmallTextBlock}" />
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Button Content="Сохранить" Margin="8,0,0,0" IsDefault="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{StaticResource Confirm}" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Key="RenameDialog" x:Shared="False" Margin="24" Width="420" d:DataContext="{d:DesignInstance Type=local:RenameEditor}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" />
            <TextBox x:Name="RenameBox" Margin="0,20,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="12" materialDesign:HintAssist.Hint="Название сессии"
                     materialDesign:HintAssist.HelperText="{Binding Hint}"
                     AutomationProperties.Name="Название сессии" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Button Content="{Binding Confirm}" Margin="8,0,0,0" IsDefault="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{StaticResource Confirm}" />
            </StackPanel>
        </StackPanel>

        <!-- Deleted projects and sessions: put back, or delete for good after a second yes. -->
        <StackPanel x:Key="ArchiveDialog" x:Shared="False" Margin="24" Width="600" d:DataContext="{d:DesignInstance Type=local:MainViewModel}">
            <TextBlock Text="Архив" Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.7" Style="{StaticResource MaterialDesignBodySmallTextBlock}"
                       Text="Удалённые проекты и сессии — с текстом, звуком и записями агентов. Срок хранения — в «Настройках»." />
            <TextBlock Margin="0,16,0,0" Text="Архив пуст." Opacity="0.6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodyMediumTextBlock}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ArchiveRows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer Margin="0,12,0,0" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ArchiveRows}" AutomationProperties.Name="Архив">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ArchiveRow}">
                            <DockPanel Margin="0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsConfirmingDelete, Converter={StaticResource CollapsedWhenTrue}}">
                                    <Button Content="Восстановить" Style="{StaticResource MaterialDesignOutlinedButton}" Click="OnRestoreArchived"
                                            AutomationProperties.Name="{Binding Title, StringFormat=Восстановить {0}}" />
                                    <Button Margin="8,0,0,0" Content="Удалить насовсем" Style="{StaticResource MaterialDesignFlatButton}"
                                            Click="OnAskDeleteForever" AutomationProperties.Name="{Binding Title, StringFormat=Удалить насовсем {0}}" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsConfirmingDelete, Converter={StaticResource VisibleWhenTrue}}">
                                    <TextBlock Text="Удалить без возврата?" VerticalAlignment="Center" Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                                    <Button Margin="8,0,0,0" Content="Удалить" Foreground="{StaticResource RecordBrush}"
                                            Style="{StaticResource MaterialDesignFlatButton}" Click="OnDeleteForever"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Да, удалить насовсем {0}'}" />
                                    <Button Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" Click="OnCancelDeleteForever" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                                    <TextBlock Text="{Binding Details}" Opacity="0.6" Style="{StaticResource MaterialDesignBodySmallTextBlock}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Margin="0,16,0,0" HorizontalAlignment="Right" Content="Закрыть" IsCancel="True" IsDefault="True"
                    Style="{StaticResource MaterialDesignFlatButton}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
        </StackPanel>

        <!-- Before a project or a session goes to the archive. -->
        <StackPanel x:Key="DeleteDialog" x:Shared="False" Margin="24" MaxWidth="420" d:DataContext="{d:DesignInstance Type=local:DeleteRequest}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" />
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.8" Text="{Binding Text}"
                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" IsDefault="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Button Content="Удалить" Margin="8,0,0,0" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{StaticResource RecordBrush}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{StaticResource Confirm}" />
            </StackPanel>
        </StackPanel>

        <Style x:Key="SettingsHeader" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignTitleSmallTextBlock}">
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>

        <Style x:Key="SettingsNote" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodySmallTextBlock}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A row of the hotkeys table: what it does and the keys, as a chip. -->
        <Style x:Key="HotkeyKeys" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource InfoContainerBrush}" />
        </Style>

        <!-- The title and Закрыть stay in view; a long body scrolls between them. -->
        <StackPanel x:Key="SettingsDialog" x:Shared="False" Margin="24,24,12,16" Width="652">
            <TextBlock Text="Настройки" Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" />
            <ScrollViewer MaxHeight="600" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Папка проектов" Style="{StaticResource SettingsHeader}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="12" AutomationProperties.Name="Выбрать папку проектов"
                                Command="{Binding ChooseFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Margin="8,0,0,0" Text="Выбрать" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBox IsReadOnly="True" TextWrapping="Wrap" Text="{Binding RootFolder, Mode=OneWay}" AutomationProperties.Name="Папка проектов"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="12" />
                    </DockPanel>

                    <TextBlock Text="Микрофон" Style="{StaticResource SettingsHeader}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="Обновить список микрофонов" AutomationProperties.Name="Обновить список микрофонов"
                                Command="{Binding RefreshDevicesCommand}">
                            <materialDesign:PackIcon Kind="Refresh" />
                        </Button>
                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                                  AutomationProperties.Name="Микрофон" DisplayMemberPath="Name"
                                  ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanEditSettings}" />
                    </DockPanel>

                    <TextBlock Text="Черновик в панели записи" Style="{StaticResource SettingsHeader}" />
                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                              AutomationProperties.Name="Частота черновика"
                              ItemsSource="{x:Static local:MainViewModel.DraftOptions}" SelectedItem="{Binding SelectedDraft}" />
                    <TextBlock Style="{StaticResource SettingsNote}"
                               Text="Черновик — главная постоянная нагрузка на видеокарту: то, что звучит сейчас, распознаётся заново с каждым обновлением. Готовые фразы распознаются один раз при любой частоте. Реже или выключен — меньше расход батареи." />

                    <TextBlock Text="Архив удалённого хранится" Style="{StaticResource SettingsHeader}" />
                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                              AutomationProperties.Name="Срок хранения архива"
                              ItemsSource="{x:Static local:MainViewModel.ArchiveOptions}" SelectedItem="{Binding SelectedArchive}" />
                    <TextBlock Style="{StaticResource SettingsNote}"
                               Text="Удалённые проекты и сессии лежат в архиве (кнопка над проектами), потом удаляются насовсем." />

                    <TextBlock Text="Хоткеи" Style="{StaticResource SettingsHeader}" />
                    <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                        <Grid Margin="14,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Действие" VerticalAlignment="Center" Opacity="0.6"
                                       Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Сочетание" VerticalAlignment="Center" Opacity="0.6"
                                       Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                            <Separator Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Следующий язык проекта" VerticalAlignment="Center"
                                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                            <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource HotkeyKeys}">
                                <TextBlock Text="{Binding Hotkeys.ToggleLanguage}" Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                            </Border>
                            <Separator Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Старт / стоп записи" VerticalAlignment="Center"
                                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                            <Border Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource HotkeyKeys}">
                                <TextBlock Text="{Binding Hotkeys.ToggleRecording}" Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                            </Border>
                            <Separator Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Отправить агенту сейчас" VerticalAlignment="Center"
                                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                            <Border Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource HotkeyKeys}">
                                <TextBlock Text="{Binding Hotkeys.ForcePush}" Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                            </Border>
                        </Grid>
                    </Border>

                    <TextBlock Text="Хаб для агентов" Style="{StaticResource SettingsHeader}" />
                    <TextBlock Style="{StaticResource MaterialDesignBodyMediumTextBlock}">
                        <Run Text="Адрес: " Foreground="Gray" /><Run Text="{Binding HubText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SettingsNote}" Text="Хоткеи и порт хаба меняются в файле:" />
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" Text="{Binding SettingsFile, Mode=OneWay}" AutomationProperties.Name="Файл настроек"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden" BorderThickness="0"
                             Style="{StaticResource MaterialDesignTextBox}" />
                    <TextBlock Style="{StaticResource SettingsNote}" Text="Изменения в файле действуют после перезапуска mictap." />

                    <TextBlock Text="Router AI" Style="{StaticResource SettingsHeader}" />
                    <TextBlock Style="{StaticResource MaterialDesignBodyMediumTextBlock}" TextWrapping="Wrap" Text="{Binding RouterAiKeyText}"
                               AutomationProperties.Name="Состояние ключа Router AI" />
                    <!-- A saved key: replace or delete it. -->
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal"
                                Visibility="{Binding ShowRouterAiKeyActions, Converter={StaticResource VisibleWhenTrue}}">
                        <Button Content="Заменить" Style="{StaticResource MaterialDesignOutlinedButton}" Click="OnReplaceRouterAiKey"
                                AutomationProperties.Name="Заменить ключ Router AI" />
                        <Button Margin="8,0,0,0" Content="Удалить" Style="{StaticResource MaterialDesignFlatButton}"
                                Click="OnDeleteRouterAiKey" AutomationProperties.Name="Удалить ключ Router AI" />
                    </StackPanel>
                    <!-- No key yet, or replacing it: paste and save; «Сохранить» only with something pasted. -->
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowRouterAiKeyInput, Converter={StaticResource VisibleWhenTrue}}">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}"
                                Click="OnCancelRouterAiKey" AutomationProperties.Name="Не менять ключ Router AI"
                                Visibility="{Binding HasRouterAiKey, Converter={StaticResource VisibleWhenTrue}}" />
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Сохранить" Style="{StaticResource MaterialDesignOutlinedButton}"
                                IsEnabled="{Binding CanSaveRouterAiKey}"
                                Click="OnSaveRouterAiKey" AutomationProperties.Name="Сохранить ключ Router AI" />
                        <PasswordBox Style="{StaticResource MaterialDesignOutlinedPasswordBox}" PasswordChanged="OnRouterAiKeyChanged"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="12" materialDesign:HintAssist.Hint="Ключ Router AI (sk-…)"
                                     AutomationProperties.Name="Ключ Router AI" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource SettingsNote}"
                               Text="Ключ хранится в диспетчере учётных данных Windows, не в файле настроек. Облако выбирается в настройках проекта: его фразы уходят в Router AI, черновик — на этом компьютере." />
                </StackPanel>
            </ScrollViewer>
            <Button Margin="0,12,12,0" HorizontalAlignment="Right" Content="Закрыть" IsCancel="True" IsDefault="True"
                    Style="{StaticResource MaterialDesignFlatButton}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
        </StackPanel>

        <Style x:Key="TreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="18" Height="18">
                            <materialDesign:PackIcon x:Name="Chevron" Kind="ChevronRight" Width="18" Height="18" Opacity="0.7"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="Turn" Angle="0" />
                                </materialDesign:PackIcon.RenderTransform>
                            </materialDesign:PackIcon>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Project rows: the row with a rounded highlight, its sessions under it, their names in line with the project's. -->
        <Style x:Key="TreeRow" TargetType="TreeViewItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" />
                            <ItemsPresenter x:Name="Children" Margin="26,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="Children" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionRow" TargetType="TreeViewItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <ContentPresenter ContentSource="Header" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The menu of a session, in the tree and on its name above the text. -->
        <ContextMenu x:Key="SessionMenu" x:Shared="False" Opened="OnSessionMenuOpened"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Переименовать" Command="{Binding RenameSessionCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Icon="{materialDesign:PackIcon Kind=PencilOutline}" />
            <MenuItem Header="Открыть папку" Command="{Binding OpenSessionFolderCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Icon="{materialDesign:PackIcon Kind=FolderOpenOutline}" />
            <MenuItem Header="Распознать заново" Command="{Binding RetranscribeCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      ToolTip="Прогнать звук сессии через VAD и Whisper ещё раз; прежний текст сохранится в transcript.&lt;время&gt;.bak"
                      Icon="{materialDesign:PackIcon Kind=Refresh}" />
            <Separator />
            <MenuItem Header="Перенести в проект" Tag="Move" Icon="{materialDesign:PackIcon Kind=FolderMoveOutline}" />
            <Separator />
            <MenuItem Header="Удалить" Command="{Binding DeleteSessionCommand}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      ToolTip="В корзину Windows: текст, звук и записи агентов; оттуда сессию можно восстановить"
                      Icon="{materialDesign:PackIcon Kind=DeleteOutline}" />
        </ContextMenu>

        <Style x:Key="TreeRowBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F000000" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource InfoContainerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AgentBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AgentCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <materialDesign:DialogHost x:Name="Dialogs" Identifier="MainDialog" CloseOnClickAway="False" DialogTheme="Inherit"
                               DialogContentUniformCornerRadius="16">
        <DockPanel x:Name="Root">
            <tb:TaskbarIcon x:Name="TrayIcon" DockPanel.Dock="Top" ToolTipText="{Binding TrayToolTip}"
                            NoLeftClickDelay="True" TrayLeftMouseUp="OnTrayOpen">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть" Click="OnTrayOpen"
                                  Icon="{materialDesign:PackIcon Kind=WindowRestore}" />
                        <MenuItem Header="Выход" Click="OnTrayExit"
                                  Icon="{materialDesign:PackIcon Kind=ExitToApp}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- App bar that doubles as the title bar: drag anywhere but on the buttons; double click maximizes. -->
            <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Height="52" Padding="16,0,8,0"
                                      materialDesign:ElevationAssist.Elevation="Dp2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource MaterialDesignToolForegroundButton}" ToolTip="Настройки"
                                AutomationProperties.Name="Настройки" Width="40" Height="40" Padding="0"
                                Command="{Binding OpenSettingsCommand}">
                            <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolForegroundButton}" ToolTip="Свернуть в трей"
                                AutomationProperties.Name="Свернуть в трей" Width="40" Height="40" Padding="0" Click="OnMinimizeClick">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="20" Height="20" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolForegroundButton}" ToolTip="Развернуть"
                                AutomationProperties.Name="Развернуть" Width="40" Height="40" Padding="0" Click="OnMaximizeClick">
                            <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="20" Height="20" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolForegroundButton}" ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть" Width="40" Height="40" Padding="0" Click="OnCloseClick">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" />
                        </Button>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Margin="0,0,12,0" Padding="10,4" CornerRadius="12"
                            VerticalAlignment="Center" Background="#33FFFFFF"
                            Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FFFF5252" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                                 Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" Text="Запись" VerticalAlignment="Center"
                                       Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                        </StackPanel>
                    </Border>

                    <!-- One line of text, so the app name and the project share a baseline. -->
                    <DockPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Microphone" Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="Проект" Style="{StaticResource MaterialDesignTitleLargeTextBlock}">
                            <Run Text="mictap" /><Run Text="{Binding Title, Mode=OneWay, StringFormat='    {0}'}" FontSize="16" Foreground="#D9FFFFFF" />
                        </TextBlock>
                    </DockPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Status line. -->
            <Border DockPanel.Dock="Bottom" Padding="20,6" BorderThickness="0,1,0,0"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                <TextBlock Style="{StaticResource MaterialDesignBodySmallTextBlock}" TextTrimming="CharacterEllipsis">
                    <Run Text="Сессия " Foreground="Gray" /><Run Text="{Binding SessionText, Mode=OneWay}" />
                    <Run Text="   Чанк " Foreground="Gray" /><Run Text="{Binding ChunkText, Mode=OneWay}" />
                    <Run Text="   Записано " Foreground="Gray" /><Run Text="{Binding RecordedText, Mode=OneWay}" />
                    <Run Text="   Язык " Foreground="Gray" /><Run Text="{Binding LanguageText, Mode=OneWay}" />
                    <Run Text="   Хаб " Foreground="Gray" /><Run Text="{Binding HubText, Mode=OneWay}" />
                    <Run Text="   Распознавание " Foreground="Gray" /><Run Text="{Binding Transcript.RuntimeText, Mode=OneWay}" />
                    <Run Text="{Binding Transcript.CloudText, Mode=OneWay}" />
                </TextBlock>
            </Border>

            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" MinWidth="180" MaxWidth="520" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="480" />
                </Grid.ColumnDefinitions>

                <!-- Projects and their sessions. -->
                <materialDesign:Card Grid.Column="0" Style="{StaticResource MaterialDesignElevatedCard}" UniformCornerRadius="16" Padding="8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,2,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                    ToolTip="Новый проект" AutomationProperties.Name="Новый проект" Command="{Binding NewProjectCommand}">
                                <materialDesign:PackIcon Kind="FolderPlusOutline" Width="18" Height="18" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                    ToolTip="Архив: удалённые проекты и сессии, их можно восстановить" AutomationProperties.Name="Архив"
                                    Command="{Binding OpenArchiveCommand}">
                                <materialDesign:PackIcon Kind="ArchiveOutline" Width="18" Height="18" />
                            </Button>
                            <TextBlock Text="Проекты" VerticalAlignment="Center" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
                        </DockPanel>
                        <TreeView x:Name="ProjectTree" ItemsSource="{Binding Projects}" ItemContainerStyle="{StaticResource TreeRow}" BorderThickness="0" Background="Transparent"
                                  SelectedItemChanged="OnTreeSelectionChanged" AutomationProperties.Name="Проекты и сессии"
                                  Tag="{Binding}">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:ProjectNode}" ItemsSource="{Binding Sessions}"
                                                          ItemContainerStyle="{StaticResource SessionRow}">
                                    <Border x:Name="Row" Style="{StaticResource TreeRowBorder}" ToolTip="{Binding RetentionText}" AllowDrop="True"
                                            DragEnter="OnProjectDragOver" DragOver="OnProjectDragOver" DragLeave="OnProjectDragLeave" Drop="OnProjectDrop"
                                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Новая сессия" Command="{Binding NewSessionCommand}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Icon="{materialDesign:PackIcon Kind=Plus}" />
                                                <MenuItem Header="Настройки проекта" Command="{Binding EditProjectCommand}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Icon="{materialDesign:PackIcon Kind=CogOutline}" />
                                                <Separator />
                                                <MenuItem Header="Удалить проект" Command="{Binding DeleteProjectCommand}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          ToolTip="В корзину Windows вместе со всеми сессиями; оттуда проект можно восстановить"
                                                          Icon="{materialDesign:PackIcon Kind=DeleteOutline}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource AgentBadge}" ToolTip="Агентов в сессиях проекта">
                                                <TextBlock Text="{Binding AgentCount}" Foreground="White" VerticalAlignment="Center"
                                                           Style="{StaticResource MaterialDesignLabelSmallTextBlock}" />
                                            </Border>
                                            <Button x:Name="AddSession" DockPanel.Dock="Right" Width="24" Height="24" Padding="0" Margin="4,0,0,0"
                                                    Visibility="Hidden" Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="Новая сессия в этом проекте" AutomationProperties.Name="Новая сессия"
                                                    Command="{Binding DataContext.NewSessionCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" />
                                            </Button>
                                            <!-- The folder turns into a chevron under the mouse: fold or unfold the sessions. -->
                                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                                <materialDesign:PackIcon x:Name="Folder" Kind="FolderOutline" Width="18" Height="18" Opacity="0.8" />
                                                <ToggleButton x:Name="Fold" Style="{StaticResource TreeExpander}" Visibility="Collapsed" ClickMode="Press"
                                                              IsChecked="{Binding IsExpanded}" ToolTip="Свернуть или развернуть сессии"
                                                              AutomationProperties.Name="Свернуть или развернуть сессии" />
                                            </Grid>
                                            <!-- The line box leaves room below for descenders: 4 px on top puts the letters level with the folder. -->
                                            <TextBlock Margin="8,4,8,0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource MaterialDesignBodyLargeTextBlock}" />
                                        </DockPanel>
                                    </Border>
                                    <HierarchicalDataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                                <Condition Binding="{Binding HasSessions}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Folder" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Fold" Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                                            <Setter TargetName="AddSession" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type local:SessionNode}">
                                    <Border Style="{StaticResource TreeRowBorder}" ContextMenu="{StaticResource SessionMenu}"
                                            PreviewMouseLeftButtonDown="OnSessionMouseDown" MouseMove="OnSessionMouseMove"
                                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource AgentBadge}" ToolTip="{Binding AgentsText}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="RobotOutline" Width="12" Height="12" Foreground="White"
                                                                             VerticalAlignment="Center" />
                                                    <TextBlock Margin="3,0,0,0" Text="{Binding AgentCount}" Foreground="White"
                                                               VerticalAlignment="Center" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" />
                                                </StackPanel>
                                            </Border>
                                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Margin="6,0,4,0" Fill="{StaticResource RecordBrush}"
                                                     VerticalAlignment="Center" ToolTip="Идёт запись"
                                                     Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                </materialDesign:Card>

                <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE"
                              ToolTip="Потяните, чтобы изменить ширину" />

                <DockPanel Grid.Column="2">
                    <!-- Recording bar, like a message box under a conversation: what is being said appears in it. -->
                    <materialDesign:Card DockPanel.Dock="Bottom" Margin="0,12,0,0" Style="{StaticResource MaterialDesignElevatedCard}"
                                         UniformCornerRadius="16" Padding="12,10">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Width="52" Height="52" ToolTip="Начать запись (Ctrl+Alt+R)" AutomationProperties.Name="Начать запись"
                                        Style="{StaticResource MaterialDesignFloatingActionButton}"
                                        Background="{StaticResource RecordBrush}" BorderBrush="{StaticResource RecordBrush}" Foreground="White"
                                        materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsStarting}"
                                        materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                        materialDesign:ButtonProgressAssist.Value="-1"
                                        Command="{Binding StartCommand}"
                                        Visibility="{Binding IsIdle, Converter={StaticResource VisibleWhenTrue}}">
                                    <materialDesign:PackIcon Kind="Microphone" Width="26" Height="26" />
                                </Button>
                                <Button Width="52" Height="52" ToolTip="Остановить запись (Ctrl+Alt+R)" AutomationProperties.Name="Остановить запись"
                                        Style="{StaticResource MaterialDesignFloatingActionButton}"
                                        Background="{StaticResource RecordBrush}" BorderBrush="{StaticResource RecordBrush}" Foreground="White"
                                        Command="{Binding StopCommand}"
                                        Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}">
                                    <materialDesign:PackIcon Kind="Stop" Width="26" Height="26" />
                                </Button>
                            </Grid>

                            <StackPanel DockPanel.Dock="Left" Margin="14,0,12,0" Width="96" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ElapsedText}" AutomationProperties.Name="Время записи" ToolTip="Время сессии — как у фраз в тексте"
                                           Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" />
                                <ProgressBar Margin="0,6,0,0" Height="6" Minimum="0" Maximum="100"
                                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                                             Background="{StaticResource InfoContainerBrush}" BorderThickness="0"
                                             materialDesign:TransitionAssist.DisableTransitions="True"
                                             Value="{Binding Level, Mode=OneWay}" AutomationProperties.Name="Уровень" />
                            </StackPanel>

                            <!-- Send, as in a chat: the agents get the text now instead of at their pause or word count. Only when some work with the recording. -->
                            <Button DockPanel.Dock="Right" Width="44" Height="44" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignIconButton}" Command="{Binding SendToAgentsCommand}"
                                    ToolTip="{Binding SendToAgentsToolTip}"
                                    Visibility="{Binding HasRecordingAgents, Converter={StaticResource VisibleWhenTrue}}"
                                    AutomationProperties.Name="{Binding SendToAgentsTitle}">
                                <materialDesign:PackIcon Kind="Send" Width="24" Height="24" />
                            </Button>

                            <!-- The draft: speech not yet in the text above, replaced every few seconds; the latest lines stay in view. -->
                            <Border MinHeight="56" CornerRadius="12" Padding="14,8" Background="#0A000000" DataContext="{Binding Transcript}">
                                <DockPanel VerticalAlignment="Center">
                                    <ProgressBar DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center"
                                                 IsIndeterminate="{Binding IsLiveBusy}" Value="0" ToolTip="Распознаётся"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Visibility="{Binding IsLive, Converter={StaticResource VisibleWhenTrue}}" />
                                    <ScrollViewer x:Name="DraftScroll" MaxHeight="66" VerticalScrollBarVisibility="Hidden" Focusable="False">
                                        <TextBlock TextWrapping="Wrap" FontSize="15" Opacity="0.55" AutomationProperties.Name="Сейчас">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodyLargeTextBlock}">
                                                    <Setter Property="Text" Value="{Binding NowText}" />
                                                    <Setter Property="FontStyle" Value="Italic" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NowText}" Value="">
                                                            <Setter Property="Text" Value="Слушаю…" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSilence}" Value="True">
                                                            <Setter Property="Text" Value="(тишина)" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDraftOff}" Value="True">
                                                            <Setter Property="Text" Value="Черновик выключен в настройках — фразы появятся в тексте после паузы." />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLive}" Value="False">
                                                            <Setter Property="Text"
                                                                    Value="{Binding DataContext.IdleDraftText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <Setter Property="FontStyle" Value="Normal" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- What just happened, or what went wrong. -->
                    <materialDesign:Card DockPanel.Dock="Bottom" Margin="0,12,0,0" UniformCornerRadius="16" Padding="16,10">
                        <materialDesign:Card.Style>
                            <Style TargetType="materialDesign:Card" BasedOn="{StaticResource MaterialDesignOutlinedCard}">
                                <Setter Property="Background" Value="{StaticResource InfoContainerBrush}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ErrorContainerBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource OnErrorContainerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Message}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:Card.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}" Width="28" Height="28"
                                    ToolTip="Скрыть" AutomationProperties.Name="Скрыть сообщение" Click="OnDismissMessage">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                            </Button>
                            <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Top">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="InformationOutline" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircleOutline" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Margin="12,0,8,0" TextWrapping="Wrap" Text="{Binding Message}" AutomationProperties.Name="Сообщение"
                                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- The text of the session: its finished phrases, editable; its name above them opens the session menu. -->
                    <materialDesign:Card Style="{StaticResource MaterialDesignElevatedCard}" UniformCornerRadius="16" Padding="14,10,20,14">
                        <DockPanel DataContext="{Binding Transcript}">
                            <DockPanel DockPanel.Dock="Top">
                                <!-- The project's language and who recognizes its phrases: next to the session, out of the way of the draft. -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ComboBox Width="150" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                                              materialDesign:HintAssist.Hint="{Binding LanguageHint}" AutomationProperties.Name="Язык речи"
                                              ToolTip="{Binding LanguageToolTip}"
                                              DisplayMemberPath="Name" SelectedValuePath="Code"
                                              ItemsSource="{Binding Languages}" SelectedValue="{Binding Language}" />
                                    <!-- The price is per minute of speech; switched before a recording. -->
                                    <ComboBox Width="300" Margin="10,0,0,0" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                                              materialDesign:HintAssist.Hint="Распознавание" AutomationProperties.Name="Распознавание фраз"
                                              ToolTip="Кто распознаёт фразы этого проекта: видеокарта или модель Router AI (платно). Можно менять и во время записи: со следующей фразы, и для тех, что ждут в очереди."
                                              MaxDropDownHeight="420" Grid.IsSharedSizeScope="True"
                                              ItemsSource="{Binding EngineChoices}" SelectedItem="{Binding SelectedEngine}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:EngineChoice}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Model" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Margin="16,0,0,0" Text="{Binding Price}" Opacity="0.6" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="SessionMenuButton" DockPanel.Dock="Left" Height="36" Padding="8,0"
                                        Style="{StaticResource MaterialDesignFlatButton}" materialDesign:ButtonAssist.CornerRadius="12"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                        DataContext="{Binding DataContext.SelectedNode, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ContextMenu="{StaticResource SessionMenu}" Click="OnSessionMenuClick"
                                        AutomationProperties.Name="Меню сессии"
                                        ToolTip="Переименовать, открыть папку, распознать заново, перенести в другой проект, удалить">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Tag.SessionHeader, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                   Style="{StaticResource MaterialDesignTitleMediumTextBlock}" />
                                        <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" Margin="6,0,0,0" Opacity="0.6"
                                                                 VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <ItemsControl Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Агенты"
                                              ItemsSource="{Binding DataContext.Agents, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:AgentRow}">
                                            <Border Margin="0,0,8,0" Padding="8,2" CornerRadius="12" Background="{StaticResource InfoContainerBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="RobotOutline" Width="14" Height="14" VerticalAlignment="Center" />
                                                    <TextBlock Margin="6,0,0,0" Text="{Binding Name}" VerticalAlignment="Center"
                                                               Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                                                    <TextBlock Margin="6,0,0,0" Text="{Binding State}" Opacity="0.7" VerticalAlignment="Center"
                                                               Style="{StaticResource MaterialDesignLabelMediumTextBlock}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Top" Margin="8,0,0,0" TextWrapping="Wrap" Opacity="0.6"
                                       Text="{Binding DataContext.SessionNote, RelativeSource={RelativeSource AncestorType=Window}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodySmallTextBlock}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock DockPanel.Dock="Top" Margin="8,4,0,0" TextWrapping="Wrap" Text="{Binding StatusText}"
                                       Foreground="{StaticResource RecordBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodySmallTextBlock}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ProgressBar DockPanel.Dock="Top" Margin="8,8,0,0" Height="6" Minimum="0" Maximum="100"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}" Value="{Binding DownloadPercent}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhenTrue}}" />

                            <TextBlock DockPanel.Dock="Top" Margin="8,4,0,0" Text="{Binding QueueText}" AutomationProperties.Name="Очередь распознавания">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodySmallTextBlock}">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding QueueText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Separator DockPanel.Dock="Top" Margin="8,8,0,6" />

                            <Grid Margin="8,0,0,0">
                                <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl Margin="0,0,8,0" ItemsSource="{Binding Items}" AutomationProperties.Name="Записано">
                                        <ItemsControl.ItemTemplate>
                                            <!-- Time and language sit on the first line of the phrase. -->
                                            <DataTemplate DataType="{x:Type local:TranscriptItem}">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Top" Opacity="0.55"
                                                               Text="{Binding TimeText}" Style="{StaticResource MaterialDesignLabelMediumTextBlock}" />
                                                    <Border Grid.Column="1" Height="18" Margin="0,7,10,0" Padding="6,0" CornerRadius="6"
                                                            VerticalAlignment="Top" Background="{StaticResource InfoContainerBrush}">
                                                        <TextBlock Text="{Binding LanguageText}" VerticalAlignment="Center"
                                                                   Style="{StaticResource MaterialDesignLabelSmallTextBlock}" />
                                                    </Border>
                                                    <TextBox Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" AutomationProperties.Name="{Binding TimeText}"
                                                             FontSize="15" VerticalAlignment="Top" materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                                             BorderThickness="0" ToolTip="Щёлкните, чтобы исправить; правка сохранится в transcript.jsonl" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Opacity="0.45"
                                           Text="{Binding DataContext.EmptyText, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodyLargeTextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </materialDesign:Card>
                </DockPanel>
            </Grid>
        </DockPanel>
    </materialDesign:DialogHost>
</Window>
