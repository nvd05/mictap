root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all

# Spaces inside square brackets: [ "ru", "ja" ], is [ 1, _ ], a[ 0 ], a[ 1.. ]; empty ones stay [] and int[].
# Multi-line brackets and braces on their own lines are not expressible here: see CLAUDE.md, «Стиль кода».
# Check: dotnet format whitespace MicTap.slnx --verify-no-changes
csharp_space_between_square_brackets = true
csharp_space_between_empty_square_brackets = false
