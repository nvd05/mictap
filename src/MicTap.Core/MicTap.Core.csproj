<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- NAudio 2.x: CLAUDE.md fixes WaveInEvent; NAudio 3 renamed it to WaveIn and marked the old name obsolete. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <!-- Wasapi: only for full device names (WinMM cuts them to 31 characters); capture stays on WaveInEvent. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- Whisper: CUDA 13 build (needs driver 580+ and CUDA Toolkit 13); the CPU runtime is the visible fallback. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MicTap.Core.Tests" />
  </ItemGroup>

</Project>
