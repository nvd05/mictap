<UserControl x:Class="MicTap.App.LanguagePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid>
        <ToggleButton x:Name="OpenPicker" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Height="48"
                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="12,10"
                      Content="{Binding Summary}" AutomationProperties.Name="Выбранные языки — раскрыть список">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Outline" CornerRadius="12" BorderBrush="#79747E" BorderThickness="1" Background="Transparent" Padding="12,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="⌄" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Background" Value="#086750A4" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#6750A4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>
        <Popup IsOpen="{Binding IsChecked, ElementName=OpenPicker, Mode=TwoWay}" StaysOpen="False" Placement="Bottom"
               PlacementTarget="{Binding ElementName=OpenPicker}" AllowsTransparency="True">
            <Border Width="{Binding ActualWidth, ElementName=OpenPicker}" MinWidth="300" Padding="12" Background="White"
                    BorderThickness="1" BorderBrush="#DDD5E7" CornerRadius="12">
                <StackPanel>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                             AutomationProperties.Name="Поиск языка по названию или коду" ToolTip="Например: рус, Russian, ru или 日本語"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                             materialDesign:HintAssist.Hint="Название или код языка" />
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Content="{Binding Star}" Padding="8,2" MinWidth="32"
                                                AutomationProperties.Name="Избранный язык"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Добавить или убрать из избранного"
                                                Style="{StaticResource MaterialDesignFlatButton}" materialDesign:ButtonAssist.CornerRadius="10" />
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Margin="0,8,0,0" Text="Первый выбранный язык используется по умолчанию." TextWrapping="Wrap" Opacity="0.6" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
