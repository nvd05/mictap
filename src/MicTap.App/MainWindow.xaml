<Window x:Class="MicTap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:local="clr-namespace:MicTap.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Style="{StaticResource MaterialDesignWindow}"
        Title="mictap" Icon="Assets/mictap.ico" Width="560" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceBrush}"
        Closing="OnWindowClosing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" CornerRadius="0"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BitmapImage x:Key="IdleIcon" UriSource="pack://application:,,,/Assets/mictap.ico" />
        <BitmapImage x:Key="RecordingIcon" UriSource="pack://application:,,,/Assets/mictap-recording.ico" />

        <sys:Boolean x:Key="Confirm">True</sys:Boolean>

        <StackPanel x:Key="CloseDialog" x:Shared="False" Margin="24" MaxWidth="360">
            <materialDesign:PackIcon Kind="MicrophoneOff" Width="28" Height="28" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Secondary}" />
            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Text="Остановить запись?"
                       Style="{StaticResource MaterialDesignHeadlineSmallTextBlock}" />
            <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Opacity="0.8"
                       Text="Идёт запись. Если закрыть mictap, она остановится, а записанное сохранится."
                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                <Button Content="Остановить и выйти" Margin="8,0,0,0" Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="{StaticResource Confirm}" />
            </StackPanel>
        </StackPanel>
    </Window.Resources>

    <materialDesign:DialogHost x:Name="Dialogs" Identifier="MainDialog" CloseOnClickAway="False" DialogTheme="Inherit">
        <DockPanel>
            <tb:TaskbarIcon x:Name="TrayIcon" DockPanel.Dock="Top" ToolTipText="{Binding TrayToolTip}"
                            NoLeftClickDelay="True" TrayLeftMouseUp="OnTrayOpen">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть" Click="OnTrayOpen"
                                  Icon="{materialDesign:PackIcon Kind=WindowRestore}" />
                        <MenuItem Header="Выход" Click="OnTrayExit"
                                  Icon="{materialDesign:PackIcon Kind=ExitToApp}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>

            <!-- App bar that doubles as the title bar: drag anywhere but on the buttons. -->
            <materialDesign:ColorZone DockPanel.Dock="Top" Mode="PrimaryMid" Height="56" Padding="16,0,8,0"
                                      materialDesign:ElevationAssist.Elevation="Dp2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource MaterialDesignToolForegroundButton}" ToolTip="Свернуть в трей"
                                AutomationProperties.Name="Свернуть в трей"
                                Width="40" Height="40" Padding="0" Click="OnMinimizeClick">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="20" Height="20" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolForegroundButton}" ToolTip="Закрыть"
                                AutomationProperties.Name="Закрыть"
                                Width="40" Height="40" Padding="0" Click="OnCloseClick">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" />
                        </Button>
                    </StackPanel>

                    <Border DockPanel.Dock="Right" Margin="0,0,12,0" Padding="10,4" CornerRadius="12"
                            VerticalAlignment="Center" Background="#33FFFFFF"
                            Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#FFFF5252" VerticalAlignment="Center">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                                 Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" Text="Запись" VerticalAlignment="Center"
                                       Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Microphone" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Margin="12,0,0,0" Text="mictap" VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignTitleLargeTextBlock}" />
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Status line: session, current chunk, recorded minutes. -->
            <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0"
                    Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}">
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="СЕССИЯ" Opacity="0.6" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding SessionText}"
                                   Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ЧАНК" Opacity="0.6" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding ChunkText}"
                                   Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="ЗАПИСАНО" Opacity="0.6" Style="{StaticResource MaterialDesignLabelSmallTextBlock}" />
                        <TextBlock Margin="0,2,0,0" Text="{Binding RecordedText}"
                                   Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <StackPanel Margin="16">
                <!-- Where and from what to record. -->
                <materialDesign:Card Style="{StaticResource MaterialDesignElevatedCard}" UniformCornerRadius="16" Padding="20,16">
                    <StackPanel>
                        <DockPanel>
                            <materialDesign:PackIcon Kind="FolderMusicOutline" Width="24" Height="24" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    AutomationProperties.Name="Выбрать папку" Command="{Binding ChooseFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" Text="Выбрать" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="16,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Папка для записей" Style="{StaticResource MaterialDesignTitleSmallTextBlock}" />
                                <TextBlock Margin="0,2,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                           Text="{Binding RootFolder, TargetNullValue='Не выбрана'}" ToolTip="{Binding RootFolder}"
                                           Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                            </StackPanel>
                        </DockPanel>

                        <Separator Margin="0,16" />

                        <DockPanel>
                            <materialDesign:PackIcon Kind="MicrophoneOutline" Width="24" Height="24" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="Обновить список микрофонов" AutomationProperties.Name="Обновить список микрофонов"
                                    Command="{Binding RefreshDevicesCommand}">
                                <materialDesign:PackIcon Kind="Refresh" />
                            </Button>
                            <ComboBox Margin="16,0,8,0" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Микрофон" DisplayMemberPath="Name"
                                      ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      IsEnabled="{Binding CanEditSettings}" />
                        </DockPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Recorder. -->
                <materialDesign:Card Margin="0,16,0,0" Style="{StaticResource MaterialDesignElevatedCard}"
                                     UniformCornerRadius="16" Padding="24,20">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" Text="{Binding ElapsedText}"
                                   Style="{StaticResource MaterialDesignDisplaySmallTextBlock}" />
                        <Grid Margin="0,16,0,8" HorizontalAlignment="Center">
                            <Button Width="72" Height="72" ToolTip="Начать запись" AutomationProperties.Name="Начать запись"
                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                    Background="{StaticResource RecordBrush}" BorderBrush="{StaticResource RecordBrush}" Foreground="White"
                                    materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsStarting}"
                                    materialDesign:ButtonProgressAssist.IsIndeterminate="True"
                                    materialDesign:ButtonProgressAssist.Value="-1"
                                    Command="{Binding StartCommand}"
                                    Visibility="{Binding IsIdle, Converter={StaticResource VisibleWhenTrue}}">
                                <materialDesign:PackIcon Kind="Microphone" Width="32" Height="32" />
                            </Button>
                            <Button Width="72" Height="72" ToolTip="Остановить запись" AutomationProperties.Name="Остановить запись"
                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                    Background="{StaticResource RecordBrush}" BorderBrush="{StaticResource RecordBrush}" Foreground="White"
                                    Command="{Binding StopCommand}"
                                    Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}">
                                <materialDesign:PackIcon Kind="Stop" Width="32" Height="32" />
                            </Button>
                        </Grid>
                        <TextBlock HorizontalAlignment="Center" Opacity="0.7" Text="{Binding RecordButtonText}"
                                   Style="{StaticResource MaterialDesignLabelLargeTextBlock}" />

                        <DockPanel Margin="0,20,0,0">
                            <materialDesign:PackIcon Kind="Waveform" Width="20" Height="20" Opacity="0.7" VerticalAlignment="Center" />
                            <ProgressBar Margin="12,0,0,0" Height="8" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         Background="{StaticResource InfoContainerBrush}" BorderThickness="0"
                                         materialDesign:TransitionAssist.DisableTransitions="True"
                                         Value="{Binding Level, Mode=OneWay}" />
                        </DockPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- What just happened, or what went wrong. -->
                <materialDesign:Card Margin="0,16,0,0" UniformCornerRadius="12" Padding="16,12">
                    <materialDesign:Card.Style>
                        <Style TargetType="materialDesign:Card" BasedOn="{StaticResource MaterialDesignOutlinedCard}">
                            <Setter Property="Background" Value="{StaticResource InfoContainerBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ErrorContainerBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource OnErrorContainerBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Message}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:Card.Style>
                    <DockPanel>
                        <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Top">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="InformationOutline" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Kind" Value="AlertCircleOutline" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" Text="{Binding Message}"
                                   Style="{StaticResource MaterialDesignBodyMediumTextBlock}" />
                    </DockPanel>
                </materialDesign:Card>
            </StackPanel>
        </DockPanel>
    </materialDesign:DialogHost>
</Window>
