<Window x:Class="MicTap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MicTap.App"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:MainViewModel}"
        Title="mictap" Width="600" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding SessionText, StringFormat='Сессия: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding ChunkText, StringFormat='Чанк: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding RecordedText, StringFormat='Записано: {0}'}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Папка:" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,8,8"
                     Text="{Binding RootFolder, Mode=OneWay, TargetNullValue='не выбрана'}" />
            <Button Grid.Row="0" Grid.Column="2" Content="Выбрать…" MinWidth="96" Padding="8,3" Margin="0,0,0,8"
                    Command="{Binding ChooseFolderCommand}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Микрофон:" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" DisplayMemberPath="Name"
                      ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      IsEnabled="{Binding CanEditSettings}" />
            <Button Grid.Row="1" Grid.Column="2" Content="Обновить" MinWidth="96" Padding="8,3" Margin="0,0,0,8"
                    Command="{Binding RefreshDevicesCommand}" />

            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,10">
                <Button Content="Старт" MinWidth="96" Padding="8,3" Margin="0,0,8,0" Command="{Binding StartCommand}" />
                <Button Content="Стоп" MinWidth="96" Padding="8,3" Command="{Binding StopCommand}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Уровень:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ProgressBar Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="16" Minimum="0" Maximum="100"
                         Value="{Binding Level, Mode=OneWay}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="{Binding Message}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="#FFC62828" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
